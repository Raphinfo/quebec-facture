datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- ÉNUMÉRATIONS ---

enum SubscriptionStatus {
  TRIALING // Essai gratuit en cours
  ACTIVE // Abonnement payé et actif
  PAST_DUE // Échec de paiement / renouvellement en retard
  CANCELED // Abonnement annulé
}

enum InvoiceStatus {
  PENDING // En attente de paiement
  PAID // Facture acquittée
  CANCELED // Facture annulée
}

enum QuoteStatus {
  DRAFT // Brouillon
  SENT // Envoyée au client
  ACCEPTED // Acceptée par le client
  REJECTED // Refusée par le client
  EXPIRED // Date de validité dépassée
  CONVERTED // Convertie en facture
}

// --- MODÈLES ---

model User {
  id             String  @id @default(uuid())
  email          String  @unique
  password       String
  companyName    String?
  neq            String?
  tpsNumber      String?
  tvqNumber      String?
  address        String?
  companyAddress String?

  // --- RELATIONS ---
  invoices Invoice[]
  clients  Client[]
  expenses Expense[]
  quotes   Quote[]

  createdAt DateTime @default(now())

  // --- ABONNEMENT ---
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  plan               String             @default("FREE")

  // --- STRIPE ---
  stripeCustomerId String? @unique
  stripeSubId      String? @unique
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String
  amountSubtotal Decimal       @db.Decimal(10, 2)
  tpsAmount      Decimal       @db.Decimal(10, 2)
  tvqAmount      Decimal       @db.Decimal(10, 2)
  amountTotal    Decimal       @db.Decimal(10, 2)
  items          Json
  status         InvoiceStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Quote {
  id          String @id @default(uuid())
  quoteNumber String

  amountSubtotal Decimal @db.Decimal(10, 2)
  tpsAmount      Decimal @db.Decimal(10, 2)
  tvqAmount      Decimal @db.Decimal(10, 2)
  amountTotal    Decimal @db.Decimal(10, 2)

  // Lignes de la soumission
  // Même principe que Invoice.items
  items Json

  status QuoteStatus @default(DRAFT)

  // Date jusqu'à laquelle la soumission est valide
  validUntil DateTime?

  // Notes ou conditions particulières
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- UTILISATEUR ---
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- CLIENT ---
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Un entrepreneur ne peut pas avoir deux soumissions
  // avec le même numéro.
  @@unique([userId, quoteNumber])
}

model Client {
  id Int @id @default(autoincrement())
  name        String
  companyName String?
  neq         String?
  address     String?
  email       String?
  phone       String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- RELATIONS ---
  invoices Invoice[]
  quotes   Quote[]

  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  category    String
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
