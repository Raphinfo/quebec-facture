datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client-js"
}
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}
enum InvoiceStatus {
  PENDING
  PAID
  CANCELED
}
enum QuoteStatus {
  DRAFT
  SENDING
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}
model User {
  id String @id @default(uuid())
  email String @unique
  password String
  companyName String?
  neq String?
  tpsNumber String?
  tvqNumber String?
  address String?
  companyAddress String?
  companyLogo String?
  interacEmail String?
  paymentTermsDays Int @default(30)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  plan String @default("FREE")
  stripeCustomerId String? @unique
  stripeSubId String? @unique
  invoiceSequence Int @default(0)
  invoicesIssued Int @default(0)
  subscriptionValidUntil DateTime? @db.Timestamptz(3)
  quoteSequence Int @default(0)
  trialUsed Boolean @default(false)
  checkoutSessionId String?
  checkoutExpiresAt DateTime?
  invoices Invoice[]
  clients Client[]
  expenses Expense[]
  quotes Quote[]
  sessions Session[]
  passwordResets PasswordReset[]
  verificationTokens VerificationToken[]
  checkoutAttempt CheckoutAttempt?
}
model Invoice {
  id String @id @default(uuid())
  invoiceNumber String @map("number")
  clientName String
  clientCompany String?
  clientEmail String?
  clientAddress String?
  itemsJson String
  // Colonnes historiques conservées pour une migration sans perte.
  sousTotal Float
  totalTPS Float
  totalTVQ Float
  totalGlobal Float
  amountSubtotal Decimal? @db.Decimal(10,2)
  tpsAmount Decimal? @db.Decimal(10,2)
  tvqAmount Decimal? @db.Decimal(10,2)
  amountTotal Decimal? @db.Decimal(10,2)
  items Json?
  status InvoiceStatus @default(PENDING)
  dueDate DateTime? @db.Date
  sentAt DateTime?
  emailId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  issuerSnapshot Json?
  clientSnapshot Json?
  sourceQuoteId String? @unique
  requestKey String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  clientId Int?
  client Client? @relation(fields:[clientId],references:[id],onDelete:Restrict)
  @@unique([userId,invoiceNumber],map:"Invoice_userId_number_key")
  @@unique([userId,requestKey])
  @@index([userId,createdAt])
}
model Quote {
  id String @id @default(uuid())
  quoteNumber String
  amountSubtotal Decimal @db.Decimal(10,2)
  tpsAmount Decimal @db.Decimal(10,2)
  tvqAmount Decimal @db.Decimal(10,2)
  amountTotal Decimal @db.Decimal(10,2)
  items Json
  status QuoteStatus @default(DRAFT)
  validUntil DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issuerSnapshot Json?
  clientSnapshot Json?
  emailId String?
  version Int @default(1)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  clientId Int
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  @@unique([userId,quoteNumber])
  @@index([userId,createdAt])
}
model Client {
  id Int @id @default(autoincrement())
  name String
  companyName String? @map("company")
  neq String?
  address String?
  email String?
  phone String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  invoices Invoice[]
  quotes Quote[]
  @@index([userId])
}
model Expense {
  id String @id @default(uuid())
  description String
  amount Decimal @db.Decimal(10,2)
  category String
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([userId])
  @@index([expiresAt])
}
model RateLimit {
  key String @id
  count Int
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}
model PasswordReset {
  tokenHash String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([userId])
}
model VerificationToken {
  tokenHash String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([userId])
}
model CheckoutAttempt {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  id String
  trial Boolean
  expiresAt DateTime @db.Timestamptz(3)
}
