# Configuration requise en production (ne jamais commiter de secrets réels)

# Base de données PostgreSQL (Neon avec TLS, idéalement région canadienne / mot de passe renouvelé)
DATABASE_URL="postgresql://utilisateur:mot_de_passe@hote.neon.tech/neondb?sslmode=require"

# Origine publique HTTPS exacte (OBLIGATOIRE en production pour Stripe, courriels et protection CSRF)
APP_URL="https://votre-domaine.com"

# Stripe (utiliser les clés LIVE en production et TEST en développement)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# ID du prix Stripe actif en CAD, 1500 cents (15,00 $), récurrent mensuel
STRIPE_PRICE_ID="price_..."
# Secret du endpoint webhook /api/webhook/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (domaine vérifié requis en production)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Québec Facture <facturation@votre-domaine.com>"

# Contacts publics & conformité Loi 25
SUPPORT_EMAIL="support@votre-domaine.com"
PRIVACY_EMAIL="confidentialite@votre-domaine.com"
PRIVACY_OFFICER_TITLE="Responsable de la protection des renseignements personnels"
OPERATOR_NAME="Votre entreprise ou nom légal"
OPERATOR_CITY="Québec, Canada"
